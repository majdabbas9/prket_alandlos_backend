{
  "name": "prket-alandlos-backend",
  "version": "1.0.0",
  "description": "Backend API for Prket Alandlos product management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "perf": "node perf/load-test.js",
    "perf:list": "node perf/load-test.js --list",
    "perf:products": "node perf/load-test.js --endpoint \"products list\"",
    "perf:products-paginated": "node perf/load-test.js --endpoint \"products paginated\"",
    "perf:products-search": "node perf/load-test.js --endpoint \"products search\"",
    "perf:product-by-id": "node perf/load-test.js --endpoint \"product by id\"",
    "perf:product-photo": "node perf/load-test.js --endpoint \"product photo\"",
    "perf:product-thumbnail": "node perf/load-test.js --endpoint \"product thumbnail\"",
    "perf:info-en": "node perf/load-test.js --endpoint \"info (en)\"",
    "perf:info-ar": "node perf/load-test.js --endpoint \"info (ar)\"",
    "perf:info-he": "node perf/load-test.js --endpoint \"info (he)\"",
    "perf:homepage-meta": "node perf/load-test.js --endpoint \"homepage meta\"",
    "perf:homepage-image": "node perf/load-test.js --endpoint \"homepage image\"",
    "perf:logo-meta": "node perf/load-test.js --endpoint \"logo meta\"",
    "perf:logo-image": "node perf/load-test.js --endpoint \"logo image\"",
    "perf:404": "node perf/load-test.js --endpoint \"404 handler\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "sharp": "^0.35.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.9",
    "supertest": "^7.2.2"
  }
}
